# Billets Hotel Booking System - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# Application
# ============================================================================
APP_NAME=Billets Hotel Booking System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# ============================================================================
# Database
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billets

# ============================================================================
# JWT Authentication
# ============================================================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# File Upload
# ============================================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880  # 5 MB in bytes
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# ============================================================================
# Payment Gateways (Optional)
# ============================================================================
# Razorpay (https://razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# Email (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@billets.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# File Storage (Optional - for production)
# ============================================================================
# AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=billets-uploads
# AWS_REGION=us-east-1
# FILE_BASE_URL=https://billets-uploads.s3.amazonaws.com

# Cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret