# Billets Hotel Booking System - Local Development Environment
# This file is for local development only - do not commit to version control

# ============================================================================
# Application
# ============================================================================
APP_NAME=Billets Hotel Booking System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# ============================================================================
# Database
# ============================================================================
# Using SQLite for local development (no PostgreSQL required)
DATABASE_URL=sqlite:///./billets.db

# ============================================================================
# JWT Authentication
# ============================================================================
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-enough
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================================
# CORS
# ============================================================================
# JSON array format for list fields
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================================
# File Upload
# ============================================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]

# ============================================================================
# Payment Gateways (Optional)
# ============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# Email (Optional)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@billets.com

FRONTEND_URL=http://localhost:5173